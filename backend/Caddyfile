{
    email omar@lammah.site
}

# إعدادات الدومين الرئيسي (الإنتاج)
lammah.site, www.lammah.site {
    request_body_limit 500mb

    # توجيه الرفع إلى خدمة Go (العمال)
    handle /api/v1/summarize/upload-temp {
        reverse_proxy uploader:8080
    }

    # توجيه باقي الـ API إلى الباك-إند (بايثون)
    handle /api/* {
        reverse_proxy backend:8000
    }

    # توجيه باقي الطلبات إلى الفرونت-إند
    handle {
        reverse_proxy frontend:3000
    }
}

api.lammah.site {
    request_body_limit 500mb

    # توجيه الرفع إلى خدمة Go
    handle /api/v1/summarize/upload-temp {
        reverse_proxy uploader:8080
    }

    # باقي الـ API إلى بايثون
    handle {
        reverse_proxy backend:8000
    }
}
